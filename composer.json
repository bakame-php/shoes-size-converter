{
    "name": "bakame/shoes-size-converter",
    "description": "shoes-size-converter library for PHP",
    "keywords": ["ISO", "shoes size", "converter"],
    "license": "MIT",
    "authors": [
        {
            "name" : "Ignace Nyamagana Butera",
            "email" : "nyamsprod@gmail.com",
            "homepage" : "https://github.com/nyamsprod/",
            "role" : "Developer"
        },
        {
            "name" : "Sarah Amft",
            "email" : "nyamsprod@gmail.com",
            "homepage" : "https://github.com/sarah-schuh",
            "role" : "Developer"
        }
    ],
    "support": {
        "docs": "https://github.com/bakame-php/stackwatch",
        "issues": "https://github.com/bakame-php/stackwatch/issues",
        "rss": "https://github.com/bakame-php/stackwatch/releases.atom",
        "source": "https://github.com/bakame-php/stackwatch"
    },
    "funding": [
        {
            "type": "github",
            "url": "https://github.com/sponsors/nyamsprod"
        }
    ],
    "require": {
        "php": "^8.2.0",
        "league/csv": "^9.28"
    },
    "require-dev": {
        "symfony/var-dumper": "^8.1",
        "phpstan/phpstan-strict-rules": "^2.0",
        "phpstan/phpstan-phpunit": "^2.0",
        "phpstan/phpstan": "^2.2",
        "phpunit/phpunit": "^13.3",
        "phpstan/phpstan-deprecation-rules": "^2.0",
        "friendsofphp/php-cs-fixer": "^3.95"
    },
    "autoload": {
        "psr-4": {
            "Bakame\\Shoes\\": "src"
        }
    },
    "scripts": {
        "phpcs": "php-cs-fixer fix -vvv --diff --dry-run --allow-risky=yes --ansi",
        "phpcs:fix": "php-cs-fixer fix -vvv --allow-risky=yes --ansi",
        "phpstan": "phpstan analyse -c phpstan.neon --ansi --memory-limit=256M",
        "phpunit": "XDEBUG_MODE=coverage phpunit --coverage-text",
        "phpunit:min": "phpunit --no-coverage",
        "test": [
            "@phpunit",
            "@phpstan",
            "@phpcs"
        ]
    },
    "scripts-descriptions": {
        "phpcs": "Runs coding style test suite",
        "phpstan": "Runs complete codebase static analysis",
        "phpunit": "Runs unit and functional testing",
        "test": "Runs full test suite"
    }
}
